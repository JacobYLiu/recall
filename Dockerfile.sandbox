# Runs the agent's tests/edits in isolation (spec Section 3: one container per run,
# repo mounted read-write, no host credentials, no network installs mid-run).
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends ripgrep git \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir pytest

WORKDIR /repo
