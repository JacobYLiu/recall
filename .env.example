# Copy to .env and fill in. .env is gitignored — never commit keys.

# At least one model provider key:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model to use (provider is inferred from which key is set; Anthropic wins if both).
RECALL_MODEL=claude-sonnet-4-5

# LangSmith tracing (on from day one — see spec Section 3).
# Set to false until you add your LangSmith key — with tracing on and no
# reachable key, runs still work but log noisy ingest errors at exit.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=recall-coding-agent

# Budgets (hard caps per run — spec Section 3)
RECALL_MAX_ITERATIONS=5
RECALL_MAX_COST_USD=2.00

# Where memory lives (defaults: ./data)
RECALL_DATA_DIR=./data
